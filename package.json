    "@types/node": "^24.0.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
